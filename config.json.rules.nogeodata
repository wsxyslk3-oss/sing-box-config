{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "cloudflare",
          "google"
        ]
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "ali",
          "tencent"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ]
        }
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "Hijacking"
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "RuleAllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "Ads_AWAvenue",
              "Advertising",
              "Privacy"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "direct"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "ChinaMax"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "Google",
          "OpenAI",
          "Telegram",
          "Global",
          "Proxy_List"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "action": "evaluate",
        "server": "dns-proxy"
      },
      {
        "match_response": true,
        "rule_set": [
          "direct",
          "ChinaMax"
        ],
        "action": "route",
        "server": "dns-direct"
      }
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "ipv4_only"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/data/adb/modules/netproxy/config/singbox/cache.db"
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9999",
      "secret": "singbox"
    }
  },
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7080
    }
  ],
  "log": {
    "disabled": false,
    "level": "info",
    "output": "stderr",
    "timestamp": true
  },
  "route": {
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      {
        "type": "local",
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "type": "remote",
        "tag": "Ads_AWAvenue",
        "format": "source",
        "url": "https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Singbox.json",
        "http_client": "s-download",
        "update_interval": "24h",
        "path": "./rules/remote/Ads_AWAvenue.json"
      },
      {
        "type": "remote",
        "tag": [
          "Advertising",
          "Privacy",
          "Hijacking",
          "ChinaMax",
          "Google",
          "OpenAI",
          "Telegram",
          "Global"
        ],
        "format": "source",
        "url": "https://raw.githubusercontent.com/senshinya/singbox_ruleset/refs/heads/main/rule/{tag}/{tag}.json",
        "http_client": "s-download",
        "update_interval": "24h",
        "path": "./rules/remote/{tag}.json"
      },
      {
        "type": "remote",
        "tag": "Proxy_List",
        "format": "source",
        "url": "https://raw.githubusercontent.com/senshinya/singbox_ruleset/refs/heads/main/rule/Proxy/Proxy.json",
        "http_client": "s-download",
        "update_interval": "24h",
        "path": "./rules/remote/Proxy_List.json"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "Hijacking"
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "RuleAllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "Ads_AWAvenue",
              "Advertising",
              "Privacy"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "direct"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "ChinaMax"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "Google",
          "OpenAI",
          "Telegram",
          "Global",
          "Proxy_List"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "match_only": true
      },
      {
        "rule_set": [
          "direct"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "ChinaMax"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "Google",
          "OpenAI",
          "Telegram",
          "Global",
          "Proxy_List"
        ],
        "action": "route",
        "outbound": "Proxy"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "Proxy"
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/modules/netproxy/webroot/sing-box-dashboard",
        "http_client": "s-download"
      }
    }
  ]
}